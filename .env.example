# luden · example configuration. Copy to .env.local and fill in your own services.
# Never commit real values. / Copia a .env.local y rellena tus propios servicios. Nunca subas valores reales.

# Public site URL used for metadata and links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (public values, required to build).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only: private data access. Never prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Signs the session cookie. Use a long random value (e.g. openssl rand -hex 32).
SUPABASE_JWT_SECRET=

# Optional: set to 1 to close public sign-up.
REGISTRATION_DISABLED=

# Optional, legacy PIN profiles created before accounts ("id:Name,id:Name").
# The owner profile "luden" uses APP_PIN; other profiles store a scrypt hash in luden_app_config.
LEGACY_PROFILES=luden:luden
APP_PIN=

# Only for authorised SQL scripts; not needed to run the interface.
# POSTGRES_URL_NON_POOLING=
